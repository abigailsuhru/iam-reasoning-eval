{
  "id": "05_notaction_exception",
  "scenario": "Explicit Deny applies to actions other than s3:GetObject.",
  "request": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::project-data/report.csv",
    "context": {}
  },
  "identity_policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::project-data/*",
          "Action": "s3:GetObject"
        }
      ]
    },
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Deny",
          "Resource": "arn:aws:s3:::project-data/*",
          "NotAction": "s3:GetObject"
        }
      ]
    }
  ],
  "permissions_boundary": null,
  "scp": null
}
