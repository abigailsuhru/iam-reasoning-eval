{
  "id": "06_boundary_intersection",
  "scenario": "Identity Allow exists but the attached boundary only permits ListBucket.",
  "request": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::project-data/report.csv",
    "context": {}
  },
  "identity_policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::project-data/*",
          "Action": "s3:GetObject"
        }
      ]
    }
  ],
  "permissions_boundary": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::project-data",
        "Action": "s3:ListBucket"
      }
    ]
  },
  "scp": null
}
