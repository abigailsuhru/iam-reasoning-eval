{
  "id": "07_scp_restriction",
  "scenario": "The SCP allows only s3:ListBucket, despite an identity-level GetObject Allow.",
  "request": {
    "action": "s3:GetObject",
    "resource": "arn:aws:s3:::project-data/report.csv",
    "context": {}
  },
  "identity_policies": [
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Resource": "arn:aws:s3:::project-data/*",
          "Action": "s3:GetObject"
        }
      ]
    }
  ],
  "permissions_boundary": null,
  "scp": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Resource": "*",
        "Action": "s3:ListBucket"
      }
    ]
  }
}
